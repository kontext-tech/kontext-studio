{
   "name": "kontext-labs-workspace",
   "version": "0.261.0",
   "private": true,
   "type": "module",
   "packageManager": "pnpm@10.24.0",
   "scripts": {
      "validate:workspace-graph": "node ./tools/validate-workspace-graph.mjs",
      "validate:workspace-versions": "node ./tools/validate-workspace-versions.mjs",
      "validate:agent-docs": "node ./tools/validate-agent-docs.mjs",
      "validate:tool-pins": "node ./tools/validate-tool-pins.mjs",
      "docs:inventory": "node ./tools/docs-capture/inventory.mjs",
      "docs:check": "node ./tools/docs-capture/run.mjs check",
      "docs:capture": "node ./tools/docs-capture/run.mjs capture",
      "docs:scaffold": "node ./tools/docs-capture/run.mjs scaffold",
      "docs:lint": "markdownlint-cli2 \"docs/user-guide/**/*.md\" \"docs/README.md\"",
      "docs:prune": "node ./tools/docs-capture/run.mjs prune",
      "docs:report": "node ./tools/docs-capture/run.mjs report",
      "docs:verify": "node ./tools/docs-capture/verify.mjs",
      "docs:site:sync": "pnpm --filter @kontext-labs/docs-site run sync",
      "docs:site:dev": "pnpm --filter @kontext-labs/docs-site run dev",
      "docs:site:build": "pnpm --filter @kontext-labs/docs-site run build",
      "docs:site:preview": "pnpm --filter @kontext-labs/docs-site run preview",
      "build": "pnpm run build:shared && pnpm --filter @kontext-labs/app build",
      "build:shared": "bash ./scripts/build-shared-packages.sh",
      "generate:api-types": "bash ./scripts/generate-api-types.sh",
      "test:python": "bash ./scripts/run-python-tests.sh",
      "test:ts": "pnpm -r --if-present test",
      "typecheck:python": "bash ./scripts/run-pyright.sh",
      "dev:app": "pnpm --filter @kontext-labs/app dev",
      "dev:notebook": "pnpm --filter notebook-demo dev",
      "dev:local": "node ./tools/start-local-mode.mjs",
      "build:app": "pnpm --filter @kontext-labs/app build",
      "build:notebook-demo": "pnpm --filter notebook-demo build",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "format": "prettier . --write",
      "format:check": "prettier . --check",
      "check:contracts": "pnpm --filter @kontext-labs/schema run check:contracts",
      "check:generator-smoke": "pnpm --filter @kontext-labs/schema run check:generator-smoke",
      "generate:models": "pnpm --filter @kontext-labs/schema run generate:models",
      "refresh:api-schema": "pnpm --filter @kontext-labs/schema run refresh-api-schema",
      "version:labs": "uv run cz bump",
      "docs:record": "node ./tools/docs-capture/run.mjs record"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@playwright/test": "^1.64.1",
      "@types/node": "^26.6.5",
      "eslint": "^10.13.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.7",
      "globals": "^17.13.0",
      "markdownlint-cli2": "^0.24.0",
      "prettier": "^3.9.10",
      "typescript": "~6.0.3",
      "typescript-eslint": "^8.72.0"
   },
   "engines": {
      "node": ">=22.12.0",
      "pnpm": ">=10.0.0"
   }
}
