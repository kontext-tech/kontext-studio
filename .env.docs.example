# Chat transcript capture configuration.
#
# Copy this file to `.env.docs.local` (gitignored) when you need to record new
# chat transcripts for the user guide:
#
#   cp .env.docs.example .env.docs.local
#   pnpm docs:record
#
# Normal captures (`pnpm docs:capture`) replay the committed transcripts and
# need no credentials. The key is read by the capture process only, is posted
# server-side to the local API, and never reaches the browser or the repository.

# Required for record mode.
OLLAMA_CLOUD_API_KEY=

# Optional override for the Ollama-compatible endpoint.
OLLAMA_CLOUD_BASE_URL=https://ollama.com
