{
   "name": "@kontext-tech/app",
   "private": true,
   "version": "0.263.1",
   "type": "module",
   "engines": {
      "node": ">=22.12.0"
   },
   "scripts": {
      "build:config": "pnpm --filter @kontext-tech/build-config build",
      "predev": "pnpm run build:config",
      "dev": "vite",
      "prestart": "pnpm run build:config",
      "start": "vite",
      "type-check": "tsc -p tsconfig.app.json --noEmit",
      "prebuild": "pnpm run build:config",
      "build": "tsc --build && vite build",
      "prebuild:prod": "pnpm run build:config",
      "build:prod": "tsc -b && vite build --mode production",
      "build:analyze": "ANALYZE=true pnpm run build",
      "build:analyze:prod": "ANALYZE=true pnpm run build:prod",
      "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
      "lint:eslint": "eslint .",
      "lint:prettier": "prettier . --check",
      "lintfix": "eslint --fix --cache . && prettier --write --list-different .",
      "prepreview": "pnpm run build:config",
      "preview": "PUBLIC_KONTEXT_API_URL=http://localhost:8101/ VITE_PORT=8002 vite preview"
   },
   "dependencies": {
      "@ant-design/icons": "^6.3.4",
      "@ant-design/x": "^2.10.0",
      "@kontext-tech/account": "workspace:*",
      "@kontext-tech/auth": "workspace:*",
      "@kontext-tech/chart": "workspace:*",
      "@kontext-tech/chat": "workspace:*",
      "@kontext-tech/common": "workspace:*",
      "@kontext-tech/event": "workspace:*",
      "@kontext-tech/file": "workspace:*",
      "@kontext-tech/icons": "workspace:*",
      "@kontext-tech/identity": "workspace:*",
      "@kontext-tech/job": "workspace:*",
      "@kontext-tech/layout": "workspace:*",
      "@kontext-tech/notebook": "workspace:*",
      "@kontext-tech/project": "workspace:*",
      "@kontext-tech/query": "workspace:*",
      "@kontext-tech/app-runtime": "workspace:*",
      "@kontext-tech/schema": "workspace:*",
      "@kontext-tech/site": "workspace:*",
      "@kontext-tech/theme": "workspace:*",
      "@kontext-tech/ui": "workspace:*",
      "@tanstack/react-query": "^5.107.1",
      "antd": "^6.7.0",
      "dayjs": "^1.11.23",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "react-router-dom": "^7.18.5"
   },
   "devDependencies": {
      "@kontext-tech/build-config": "workspace:*",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "eslint": "^10.14.0",
      "prettier": "^3.9.10",
      "rollup-plugin-visualizer": "^7.1.2",
      "sass-embedded": "^1.108.1",
      "terser": "^5.51.2",
      "typescript": "~6.0.3",
      "vite": "^8.3.6",
      "vite-plugin-compression2": "^2.5.4",
      "vite-plugin-svgr": "^5.2.0"
   }
}
