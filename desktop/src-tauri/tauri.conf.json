{
   "$schema": "https://schema.tauri.app/config/2",
   "productName": "Kontext Studio",
   "version": "0.263.0",
   "identifier": "tech.kontext.studio",
   "build": {
      "frontendDist": "../splash",
      "beforeDevCommand": "",
      "beforeBuildCommand": ""
   },
   "app": {
      "withGlobalTauri": true,
      "windows": [],
      "security": {
         "csp": null
      }
   },
   "bundle": {
      "active": true,
      "targets": ["app"],
      "icon": [
         "icons/32x32.png",
         "icons/128x128.png",
         "icons/128x128@2x.png",
         "icons/icon.icns",
         "icons/icon.ico"
      ],
      "resources": {
         "resources/python": "python",
         "resources/wheelhouse": "wheelhouse",
         "resources/third-party": "third-party"
      },
      "macOS": {
         "minimumSystemVersion": "13.0",
         "signingIdentity": "-",
         "hardenedRuntime": false,
         "entitlements": "Entitlements.plist",
         "infoPlist": "Info.plist"
      }
   }
}
