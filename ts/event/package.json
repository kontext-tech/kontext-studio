{
   "name": "@kontext-labs/event",
   "version": "0.261.0",
   "type": "module",
   "description": "Shared event display components for Kontext",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
