         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "pnpm run type-check && tsc --build",
      "type-check": "tsc --build && tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@kontext-labs/common": "workspace:*",
      "@kontext-labs/icons": "workspace:*",
      "@kontext-labs/identity": "workspace:*",
      "@kontext-labs/app-runtime": "workspace:*",
      "@kontext-labs/schema": "workspace:*",
      "antd": "^6.6.7",
      "react": "^19.3.1"
   },
   "devDependencies": {
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
