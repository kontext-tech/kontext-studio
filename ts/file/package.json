{
   "name": "@kontext-tech/file",
   "version": "0.263.1",
   "type": "module",
   "description": "Shared file domain services, hooks, types, and components for Kontext",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "pnpm run type-check && tsc --build",
      "type-check": "tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@kontext-tech/auth": "workspace:*",
      "@kontext-tech/common": "workspace:*",
      "@kontext-tech/icons": "workspace:*",
      "@kontext-tech/app-runtime": "workspace:*",
      "@kontext-tech/schema": "workspace:*",
      "@kontext-tech/site": "workspace:*",
      "@kontext-tech/ui": "workspace:*",
      "@tanstack/react-query": "^5.107.1",
      "antd": "^6.7.0",
      "react": "^19.3.1"
   },
   "devDependencies": {
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
