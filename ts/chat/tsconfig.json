{
   "extends": "../build-config/tsconfig/library-package.json",
   "compilerOptions": {
      "target": "ES2020",
      "useDefineForClassFields": true,
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "skipLibCheck": true,
      "noEmitOnError": true,
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": false,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "composite": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noFallthroughCasesInSwitch": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "paths": {
         "@kontext-labs/common": ["../common/src/index.ts"],
         "@kontext-labs/common/*": ["../common/src/*"],
         "@kontext-labs/identity": ["../identity/src/index.ts"],
         "@kontext-labs/identity/*": ["../identity/src/*"],
         "@kontext-labs/notebook": ["../notebook/src/index.ts"],
         "@kontext-labs/ui": ["../ui/src/index.ts"],
         "@kontext-labs/icons": ["../icons/src/index.ts"],
         "@kontext-labs/schema": ["../schema/src/index.ts"],
         "@kontext-labs/file": ["../file/src/index.ts"],
         "@kontext-labs/file/*": ["../file/src/*"],
         "@kontext-labs/app-runtime": ["../app-runtime/src/index.ts"]
      }
   },
   "references": [
      {
         "path": "../common"
      },
      {
         "path": "../icons"
      },
      {
         "path": "../identity"
      },
      {
         "path": "../schema"
      },
      {
         "path": "../app-runtime"
      },
      {
         "path": "../notebook"
      },
      {
         "path": "../ui"
      },
      {
         "path": "../file"
      }
   ],
   "include": ["src"],
   "exclude": [
      "node_modules",
      "dist",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/__tests__/**/*"
   ]
}
