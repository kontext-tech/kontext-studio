{
   "name": "@kontext-tech/chart",
   "version": "0.263.1",
   "type": "module",
   "description": "Chart components and utilities for Kontext",
   "files": [
      "dist"
   ],
   "main": "dist/index.js",
   "module": "dist/index.js",
   "types": "dist/index.d.ts",
   "exports": {
      ".": {
         "import": "./dist/index.js",
         "types": "./dist/index.d.ts"
      }
   },
   "scripts": {
      "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build --force && tsc-alias -p tsconfig.json",
      "test": "jest",
      "lint": "eslint src/**/*.{ts,tsx}",
      "lint:fix": "eslint src/**/*.{ts,tsx} --fix"
   },
   "keywords": [
      "charts",
      "kontext",
      "visualization",
      "antd-plots"
   ],
   "author": "Kontext Team",
   "license": "MIT",
   "dependencies": {
      "@ant-design/plots": "2.6.8",
      "@kontext-tech/common": "workspace:*",
      "@kontext-tech/file": "workspace:*",
      "@kontext-tech/icons": "workspace:*",
      "@kontext-tech/query": "workspace:*",
      "@kontext-tech/schema": "workspace:*",
      "@kontext-tech/theme": "workspace:*",
      "@kontext-tech/ui": "workspace:*",
      "antd": "^6.7.0",
      "react": "^19.3.1",
      "zod": "^4.6.7"
   },
   "devDependencies": {
      "@types/jest": "^30.0.0",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "jest": "^30.5.2",
      "ts-jest": "^29.4.15",
      "tsc-alias": "^1.9.10",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1",
      "react-dom": ">=18.3.1"
   },
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
