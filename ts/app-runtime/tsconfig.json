{
   "extends": "../build-config/tsconfig/library-package.json",
   "compilerOptions": {
      "composite": true,
      "target": "ES2020",
      "useDefineForClassFields": true,
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "skipLibCheck": true,
      "noEmitOnError": true,
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": false,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noFallthroughCasesInSwitch": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "paths": {
         "@kontext-labs/common": ["../common/src/index.ts"],
         "@kontext-labs/common/*": ["../common/src/*"]
      }
   },
   "references": [
      {
         "path": "../common"
      }
   ],
   "include": ["src"],
   "exclude": ["node_modules", "dist"]
}
