{
   "extends": "../build-config/tsconfig/library-package.json",
   "compilerOptions": {
      "target": "ES2020",
      "useDefineForClassFields": true,
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "skipLibCheck": true,
      "noEmitOnError": true,
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": false,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "composite": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noFallthroughCasesInSwitch": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "paths": {
         "@kontext-labs/auth": ["../auth/src/index.ts"],
         "@kontext-labs/auth/*": ["../auth/src/*"],
         "@kontext-labs/common": ["../common/src/index.ts"],
         "@kontext-labs/common/*": ["../common/src/*"],
         "@kontext-labs/host-api": ["../host-api/src/index.ts"],
         "@kontext-labs/icons": ["../icons/src/index.ts"],
         "@kontext-labs/icons/*": ["../icons/src/*"],
         "@kontext-labs/schema": ["../schema/src/index.ts"],
         "@kontext-labs/schema/*": ["../schema/src/*"]
      }
   },
   "references": [
      {
         "path": "../auth"
      },
      {
         "path": "../common"
      },
      {
         "path": "../host-api"
      },
      {
         "path": "../icons"
      },
      {
         "path": "../schema"
      }
   ],
   "include": ["src"],
   "exclude": ["node_modules", "dist"]
}
