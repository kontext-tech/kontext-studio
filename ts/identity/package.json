{
   "name": "@kontext-tech/identity",
   "version": "0.263.0",
   "type": "module",
   "description": "Shared current-user identity state and UI for Kontext",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "pnpm run type-check && tsc --build",
      "type-check": "tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@kontext-tech/auth": "workspace:*",
      "@kontext-tech/common": "workspace:*",
      "@kontext-tech/host-api": "workspace:*",
      "@kontext-tech/icons": "workspace:*",
      "@kontext-tech/schema": "workspace:*",
      "antd": "^6.6.7",
      "react": "^19.3.1",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
