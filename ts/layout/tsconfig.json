{
   "files": ["../common/src/constants/env.d.ts"],
   "extends": "../build-config/tsconfig/library-package.json",
   "compilerOptions": {
      "target": "ES2020",
      "useDefineForClassFields": true,
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "skipLibCheck": true,
      "noEmitOnError": true,
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": false,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noFallthroughCasesInSwitch": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "paths": {
         "@kontext-tech/common": ["../common/src/index.ts"],
         "@kontext-tech/icons": ["../icons/src/index.ts"],
         "@kontext-tech/theme": ["../theme/src/index.ts"]
      }
   },
   "references": [
      {
         "path": "../common"
      },
      {
         "path": "../icons"
      },
      {
         "path": "../theme"
      },
      {
         "path": "../ui"
      }
   ],
   "include": ["src"],
   "exclude": ["node_modules", "dist"]
}
