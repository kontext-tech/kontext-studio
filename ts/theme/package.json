{
   "type": "module",
   "name": "@kontext-labs/theme",
   "version": "0.261.0",
   "description": "Kontext shared theme runtime and design tokens",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "import": "./dist/index.js",
         "types": "./dist/index.d.ts"
      }
   },
   "scripts": {
      "build": "pnpm run type-check && tsc --build",
      "type-check": "tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@kontext-labs/common": "workspace:*",
      "@kontext-labs/icons": "workspace:*",
      "antd": "^6.6.7",
      "react": "^19.3.1"
   },
   "peerDependencies": {
      "antd": "*",
      "react": ">=18.3.1"
   },
   "devDependencies": {
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
