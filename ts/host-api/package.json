{
   "name": "@kontext-tech/host-api",
   "version": "0.261.3",
   "type": "module",
   "description": "Host API for Kontext local and hosted runtimes",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
