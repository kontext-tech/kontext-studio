{
   "name": "@kontext-labs/common",
   "version": "0.261.0",
   "type": "module",
   "description": "Shared common package for Kontext with Ant Design customization and Lucide icons",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./constants": {
         "types": "./dist/constants/index.d.ts",
         "import": "./dist/constants/index.js"
      },
      "./constants/*": {
         "types": "./dist/constants/*.d.ts",
         "import": "./dist/constants/*.js"
      },
      "./container": {
         "types": "./dist/container/index.d.ts",
         "import": "./dist/container/index.js"
      },
      "./types": {
         "types": "./dist/types/index.d.ts",
         "import": "./dist/types/index.js"
      },
      "./types/*": {
         "types": "./dist/types/*.d.ts",
         "import": "./dist/types/*.js"
      },
      "./utils": {
         "types": "./dist/utils/index.d.ts",
         "import": "./dist/utils/index.js"
      },
      "./services": {
         "types": "./dist/services/index.d.ts",
         "import": "./dist/services/index.js"
      },
      "./services/*": {
         "types": "./dist/services/*.d.ts",
         "import": "./dist/services/*.js"
      },
      "./stores": {
         "types": "./dist/stores/index.d.ts",
         "import": "./dist/stores/index.js"
      },
      "./stores/*": {
         "types": "./dist/stores/*.d.ts",
         "import": "./dist/stores/*.js"
      },
      "./assets": {
         "types": "./dist/assets/index.d.ts",
         "import": "./dist/assets/index.js"
      },
      "./assets/*": "./dist/assets/*",
      "./resources/*": "./dist/resources/*"
   },
   "scripts": {
      "build": "pnpm run type-check && tsc --build && mkdir -p dist/assets && cp src/assets/*.svg src/assets/*.png dist/assets/ && mkdir -p dist/resources && cp -R src/resources/* dist/resources/",
      "type-check": "tsc --noEmit",
      "test": "jest",
      "dev": "tsc --watch",
      "lint": "eslint src",
      "lint:fix": "eslint src --fix"
   },
   "keywords": [
      "theme",
      "kontext",
      "ant-design",
      "lucide",
      "icons"
   ],
   "author": "Kontext Tech",
   "license": "MIT",
   "dependencies": {
      "@kontext-labs/schema": "workspace:*",
      "date-fns": "^4.4.0",
      "lucide": "1.61.0",
      "openapi-fetch": "^0.17.0",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@types/jest": "^30.0.0",
      "@types/node": "^26.6.5",
      "eslint": "^10.13.0",
      "jest": "^30.5.2",
      "ts-jest": "^29.4.15",
      "typescript": "~6.0.3"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
