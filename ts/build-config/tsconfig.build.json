{
   "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "types": ["node"],
      "strict": true,
      "skipLibCheck": true,
      "verbatimModuleSyntax": true,
      "moduleDetection": "force",
      "allowImportingTsExtensions": true,
      "rewriteRelativeImportExtensions": true,
      "noEmit": false,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "rootDir": ".",
      "outDir": "./dist",
      "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo"
   },
   "include": ["vite/**/*.ts"]
}
