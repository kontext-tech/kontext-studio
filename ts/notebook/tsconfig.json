{
   "extends": "../build-config/tsconfig/library-package.json",
   "compilerOptions": {
      "target": "ES2020",
      "lib": ["DOM", "DOM.Iterable", "ESNext"],
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "module": "ESNext",
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": false,
      "jsx": "react-jsx",
      "declaration": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "sourceMap": true,
      "paths": {
         "@notebook/*": ["./src/*"],
         "@kontext-labs/query": ["../query/src/index.ts"],
         "@kontext-labs/query/*": ["../query/src/*"]
      },
      "composite": true,
      "types": ["node"]
   },
   "references": [
      {
         "path": "../chart"
      },
      {
         "path": "../common"
      },
      {
         "path": "../file"
      },
      {
         "path": "../icons"
      },
      {
         "path": "../query"
      },
      {
         "path": "../schema"
      },
      {
         "path": "../theme"
      },
      {
         "path": "../ui"
      }
   ],
   "include": ["./src/**/*.ts", "./src/**/*.tsx", "./src/**/*.notebook"],
   "exclude": [
      "./node_modules",
      "./dist",
      "./src/**/__tests__/**",
      "./src/**/*.test.ts",
      "./src/**/*.test.tsx",
      "./src/**/*.spec.ts",
      "./src/**/*.spec.tsx"
   ]
}
