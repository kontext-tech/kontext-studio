{
   "name": "@kontext-tech/query",
   "version": "0.261.2",
   "type": "module",
   "description": "Domain facade for query-related state, services, and UI",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./sql-editor": {
         "types": "./dist/sql-editor.d.ts",
         "import": "./dist/sql-editor.js"
      },
      "./query-results": {
         "types": "./dist/query-results.d.ts",
         "import": "./dist/query-results.js"
      }
   },
   "scripts": {
      "build": "pnpm run type-check && tsc --build",
      "type-check": "tsc --build && tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@codemirror/lang-sql": "^6.10.0",
      "@codemirror/view": "^6.43.15",
      "@kontext-tech/common": "workspace:*",
      "@kontext-tech/icons": "workspace:*",
      "@kontext-tech/identity": "workspace:*",
      "@kontext-tech/app-runtime": "workspace:*",
      "@kontext-tech/schema": "workspace:*",
      "@kontext-tech/ui": "workspace:*",
      "@uiw/react-codemirror": "^4.25.12",
      "antd": "^6.6.7",
      "react": "^19.3.1",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
