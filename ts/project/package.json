{
   "name": "@kontext-labs/project",
   "version": "0.261.0",
   "type": "module",
   "description": "Domain facade for project state, services, and shared project hooks",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "rm -rf dist tsconfig.tsbuildinfo && pnpm run type-check && tsc --build",
      "type-check": "tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@kontext-labs/auth": "workspace:*",
      "@kontext-labs/chart": "workspace:*",
      "@kontext-labs/chat": "workspace:*",
      "@kontext-labs/common": "workspace:*",
      "@kontext-labs/host-api": "workspace:*",
      "@kontext-labs/icons": "workspace:*",
      "@kontext-labs/identity": "workspace:*",
      "@kontext-labs/app-runtime": "workspace:*",
      "@kontext-labs/schema": "workspace:*",
      "@kontext-labs/theme": "workspace:*",
      "@kontext-labs/ui": "workspace:*",
      "@tanstack/react-query": "^5.104.5",
      "antd": "^6.6.7",
      "react": "^19.3.1",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
