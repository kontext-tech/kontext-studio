{
   "name": "@kontext-tech/project",
   "version": "0.264.0",
   "type": "module",
   "description": "Domain facade for project state, services, and shared project hooks",
   "license": "MIT",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "node ../../scripts/clean-dist.mjs dist tsconfig.tsbuildinfo && pnpm run type-check && tsc --build",
      "type-check": "tsc --noEmit",
      "dev": "tsc --watch"
   },
   "dependencies": {
      "@kontext-tech/auth": "workspace:*",
      "@kontext-tech/chart": "workspace:*",
      "@kontext-tech/chat": "workspace:*",
      "@kontext-tech/common": "workspace:*",
      "@kontext-tech/host-api": "workspace:*",
      "@kontext-tech/icons": "workspace:*",
      "@kontext-tech/identity": "workspace:*",
      "@kontext-tech/app-runtime": "workspace:*",
      "@kontext-tech/schema": "workspace:*",
      "@kontext-tech/theme": "workspace:*",
      "@kontext-tech/ui": "workspace:*",
      "@tanstack/react-query": "^5.107.1",
      "antd": "^6.7.0",
      "react": "^19.3.1",
      "zustand": "^5.1.0"
   },
   "devDependencies": {
      "@types/react": "^19.3.0",
      "typescript": "~6.0.3"
   },
   "peerDependencies": {
      "react": ">=18.3.1"
   },
   "files": [
      "dist"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com",
      "access": "public"
   }
}
