# Kontext — environment configuration
#
# Copy this file to `.env.local` and adjust for your environment. It is loaded
# by the local server (`uv run --env-file .env.local kontext-labs serve`) and by
# `pnpm run dev:local` (tools/start-local-mode.mjs).
#
# Most values below are the local-development defaults; leave them as-is for a
# working out-of-the-box setup.

# --- Local mode / feature flags ---
# Internal deployment-profile switch. The local launcher sets this; keep it
# "true" for a local server. The cloud OpenAPI exporter passes its profile
# explicitly and does not rely on this value.
KONTEXT_LOCAL_MODE=true
IS_DEVELOPMENT=true

# Site feature flags control which capability-gated surfaces this deployment
# serves (they gate both the API routers and the frontend navigation). Local mode
# advertises local-mode, model-connections and python-environment by default.
# Enable extras or slim the deployment without a code change:
# KONTEXT_SITE_FEATURES=notifications
# KONTEXT_DISABLED_SITE_FEATURES=model-connections

# --- Local job worker / kernels ---
# `kontext-labs serve` supervises a worker process that executes jobs and owns
# the Python kernel processes; the API never runs job code itself.
# How many jobs the worker runs at once (default 2):
# KONTEXT_LOCAL_WORKER_CONCURRENCY=2
# How often the worker checks for queued runs when idle, in seconds (default 0.5):
# KONTEXT_LOCAL_WORKER_POLL_INTERVAL=0.5
# How often the worker reaps session kernels whose chat/notebook was deleted,
# in seconds (default 60):
# KONTEXT_LOCAL_SESSION_REAP_INTERVAL=60
# Restart the worker if it exits unexpectedly (default true):
# KONTEXT_LOCAL_WORKER_WATCHDOG=true
# Start the worker alongside `serve` (default true; set false to run it yourself):
# KONTEXT_LOCAL_WORKER_ENABLED=true
# Packages installed into the managed Python environment (numpy/pandas/etc.):
# KONTEXT_PYTHON_RUNTIME_PACKAGES=numpy==2.2.5,pandas==2.2.3

# --- Filesystem access policy ---
# Kontext confines local file reads/writes (uploads, catalog connections,
# external SQLite/DuckDB databases, local warehouses, and `open()`/pandas
# file access inside managed Python cells) to its managed storage directory.
# To let it reach additional directories, list them here separated by the OS
# path separator (":" on macOS/Linux, ";" on Windows):
# KONTEXT_ALLOWED_PATHS=/Users/you/data:/Users/you/other

# --- Model provider (pick one) ---
# MODEL_PROVIDER can be one of: openai, anthropic, gemini, google_vertex,
# openrouter, ollama, ollama_cloud, lm_studio, deepseek, mistral, azure_openai,
# bedrock, or openai_compatible. Uncomment the keys for the provider you use.
# MODEL_PROVIDER=ollama
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_API_BASE=https://ollama.com
# LM_STUDIO_API_BASE=http://localhost:1234
# GOOGLE_VERTEX_MODEL=gemini/gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=2024-10-21
# BEDROCK_REGION=ap-southeast-2

# --- Optional public runtime URLs ---
# `kontext-labs serve` injects the API URL at runtime (window.location.origin),
# and `pnpm run dev:local` sets these for the dev server, so they are only
# needed to override the built-in defaults (for example a hosted build).
#
# Canonical port block (one place to override in a deployment):
#   8000  API server (standalone `kontext-api` container EXPOSE / uvicorn
#         default / `kontext-labs serve` default / data-API URL fallback)
#   8002  console app (Vite dev server, `PUBLIC_KONTEXT_APP_URL`)
#   8101  hosted-facing API port used as the *client* default URL when the
#         API is deployed behind a fixed host-port mapping; set explicitly in
#         deployments that do not use that mapping — the local server always
#         serves 8000 (window.location.origin overrides this in local use).
# PUBLIC_KONTEXT_API_URL=http://localhost:8101
# PUBLIC_KONTEXT_DATA_API_URL=http://localhost:8000
# PUBLIC_KONTEXT_URL=http://localhost:8006
# PUBLIC_KONTEXT_APP_URL=http://localhost:8002
# PUBLIC_KONTEXT_DOCS_URL=https://docs.kontext.tech
# Platform URL (PUBLIC_KONTEXT_URL) is the hosted site surfaced in console
# links; it falls back to https://kontext.tech when unset, and 8006 is the
# dev-server default injected by `pnpm dev` / build-app-image.sh. The docs URL
# drives the Help -> Docs link and falls back to https://docs.kontext.tech.
