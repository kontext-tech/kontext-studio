---
import Default from "@astrojs/starlight/components/Footer.astro";

const year = new Date().getFullYear();
---

<Default />
<div class="site-footer">
   <span>&copy; {year} Kontext</span>
   <nav aria-label="Site links">
      <a href="https://kontext.tech">Platform</a>
      <a href="https://github.com/kontext-tech/kontext-labs">GitHub</a>
      <a href="https://kontext.tech/contact">Contact</a>
   </nav>
</div>

<style>
   .site-footer {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--sl-color-gray-6);
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
   }

   .site-footer nav {
      display: flex;
      gap: 1rem;
   }

   .site-footer a {
      color: inherit;
      text-decoration: none;
   }

   .site-footer a:hover {
      color: var(--sl-color-accent);
   }
</style>
